# DAP environment template — copy to .env (or export in your shell) and fill in.
# .env is gitignored; this template is the reference.

# ─── LLM backend (agentic engine) ───────────────────────────
# Without DAP_LLM_API_KEY the agents use built-in heuristics (no external calls).
# Any OpenAI-compatible endpoint works (OpenAI, Azure, Ollama, vLLM, LiteLLM).
DAP_LLM_API_KEY=
DAP_LLM_BASE_URL=https://api.openai.com/v1
DAP_LLM_MODEL=gpt-4o-mini
DAP_LLM_TIMEOUT=60
DAP_LLM_MAX_TOKENS=4096

# ─── Auth ───────────────────────────────────────────────────
# DAP_AUTH_STRICT=1 → fail-closed (PRODUCTION): unknown users / bad passwords /
# invalid tokens are rejected with 401. Unset/0 → dev fail-open: unregistered
# users get legacy mock tokens so local previews keep working.
DAP_AUTH_STRICT=0
# JWT signing key (HS256). REQUIRED in production — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it a dev-only fallback key is used (never deploy with the fallback).
DAP_JWT_SECRET=

# ─── Database ───────────────────────────────────────────────
# TESTING=1 selects the SQLite backend (no PostgreSQL needed) for local dev/tests.
# Without it, the platform targets PostgreSQL via DATABASE_URL
# (default postgresql+asyncpg://postgres:secret@localhost:5432/dap).
TESTING=
DATABASE_URL=
# Postgres credentials used by templates/docker/DOCKERCOMPOSE_PROD.yml
POSTGRES_DB=dap
POSTGRES_USER=dap
POSTGRES_PASSWORD=

# ─── Sandbox execution backend ──────────────────────────────
# auto (default) = podman if on PATH, else the in-memory null backend
# podman | runsc (gVisor) = forced (falls back to null when the binary is absent)
# null = in-memory no-op (original stub behavior)
DAP_SANDBOX_RUNTIME=auto

# ─── Dashboard ──────────────────────────────────────────────
# API base URL the browser dashboard polls (default http://localhost:8001).
# The production compose stack sets this to http://api:8001 automatically.
DAP_API_URL=http://localhost:8001

# ─── Production networkability (Caddy / Let's Encrypt) ──────
# Public hostname (e.g. dap.example.com). Must A/AAAA-record to the host for
# the HTTP-01 challenge. Used by templates/docker/Caddyfile.
DAP_PUBLIC_HOST=dap.local
