# =============================================
# DevOps Agentic Development Platform (DAP) — .gitignore
# =============================================

# Virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
env/
venv/

# IDE / Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Distribution / Packaging
dist/
build/
*.egg-info/
MANIFEST
MANIFEST.local
.Python
*.egg

# Testing / Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
dap_test.db
# ^ generated by the test suite (TESTING=1)

# Environment files (secrets, never commit)
.env
.env.*.local
!.env.template
*.pem

# Docker artifacts (root-level only; templates/docker/ is tracked)
/docker/
docker-compose.override.yml

# Kubernetes artifacts (generated)
kubeconfig
*.kubeconfig

# Terraform state (never commit)
.terraform/
*.tfstate
*.tfstate.backup

# Generated / Auto-generated files
generated/
__generated__/
migrations/*.py.bak

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Temporary / Scratch files
*.tmp
*.temp
*.log
npm-debug.log*
yarn-debug.log*

# IDE temp files
.idea/inspector/
*.swx
*.swo

# Log files from services
logs/
var/log/
app.log
error.log
access.log

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
